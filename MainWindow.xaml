<Window x:Class="Padlume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Padlume"
        Title="Padlume" Height="680" Width="760" MinWidth="680"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- No TargetType/x:Key here on purpose: applies on its own to every scrollbar in the window
             (the main one and the controller list's in the popup), instead of Windows' default white
             scrollbar which clashes with the rest of the app. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="{DynamicResource DimBrush}" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3B6BFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.3" Color="{DynamicResource ShadowColor}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B6BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2759D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D43B6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="#CBDBFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#3B6BFF" BorderThickness="1.4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2233"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2A4A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6E9BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineIconButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="#8FB4FF"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="#3B6BFF" BorderThickness="1.4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2233"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControllerListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="12" BorderThickness="1.5" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding PhotoSource}" Visibility="{Binding PhotoSource, Converter={StaticResource NullToVisibilityConverter}}" Stretch="Uniform" Margin="3"/>
                                        <Viewbox Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding PhotoSource, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                            <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M11,13H8v3H6v-3H3v-2h3V8h2v3h3V13z M15.5,15c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S16.33,15,15.5,15z M19.5,12c-0.83,0-1.5-0.67-1.5-1.5S18.67,9,19.5,9s1.5,0.67,1.5,1.5S20.33,12,19.5,12z"/>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="●" Foreground="#4ADE80"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding StatusLine, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#F5A623" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Text="{x:Static local:Strings.Blocked}"/>
                                </StackPanel>
                                <TextBlock x:Name="Check" Grid.Column="2" Text="✓" FontSize="16" FontWeight="Bold" Foreground="#3B6BFF" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#3B6BFF"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="#3B6BFF" BorderThickness="1.4" VerticalAlignment="Center">
                                <TextBlock x:Name="Check" Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3B6BFF"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6E9BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="BluetoothPulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="PulseScaleOuter" Storyboard.TargetProperty="ScaleX" From="1" To="1.9" Duration="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseScaleOuter" Storyboard.TargetProperty="ScaleY" From="1" To="1.9" Duration="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseRingOuter" Storyboard.TargetProperty="Opacity" From="0.35" To="0" Duration="0:0:2" RepeatBehavior="Forever"/>

            <DoubleAnimation Storyboard.TargetName="PulseScaleInner" Storyboard.TargetProperty="ScaleX" From="1" To="1.9" Duration="0:0:2" BeginTime="0:0:1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseScaleInner" Storyboard.TargetProperty="ScaleY" From="1" To="1.9" Duration="0:0:2" BeginTime="0:0:1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseRingInner" Storyboard.TargetProperty="Opacity" From="0.35" To="0" Duration="0:0:2" BeginTime="0:0:1" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Top">
                <Ellipse x:Name="PulseRingOuter" Width="64" Height="64" Fill="#3B6BFF" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScaleOuter" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="PulseRingInner" Width="64" Height="64" Fill="#3B6BFF" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScaleInner" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource SurfaceBrush}" BorderBrush="#3B82F6" BorderThickness="2">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-3,-1,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Strings.ControllersDetected}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Static local:Strings.BluetoothOrUsb}" FontSize="14" Foreground="#5B8CFF" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <ToggleButton x:Name="SelectorToggle" Style="{StaticResource OutlineToggleButton}" IsChecked="{Binding IsOpen, ElementName=ControllerPopup, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center">
                            <Path Fill="#CBDBFF" Data="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M11,13H8v3H6v-3H3v-2h3V8h2v3h3V13z M15.5,15c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S16.33,15,15.5,15z M19.5,12c-0.83,0-1.5-0.67-1.5-1.5S18.67,9,19.5,9s1.5,0.67,1.5,1.5S20.33,12,19.5,12z"/>
                        </Viewbox>
                        <TextBlock Text="{x:Static local:Strings.SelectController}" Margin="9,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="RefreshIconButton" Style="{StaticResource OutlineIconButton}" Click="RefreshButton_Click" Margin="10,0,0,0" ToolTip="{x:Static local:Strings.RefreshTooltip}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <Button x:Name="CompactModeButton" Style="{StaticResource OutlineIconButton}" Click="CompactModeButton_Click" Margin="10,0,0,0" ToolTip="{x:Static local:Strings.CompactModeTooltip}">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
            </StackPanel>

            <Popup x:Name="ControllerPopup" PlacementTarget="{Binding ElementName=SelectorToggle}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" Width="380" Opened="ControllerPopup_Opened">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="{DynamicResource ShadowColor}"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Strings.ChooseTheController}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,8,10,10"/>

                        <ListBox x:Name="ControllerListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="320"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ControllerListItemStyle}"
                                 SelectionChanged="ControllerListBox_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <TextBlock x:Name="EmptyListText" Text="{x:Static local:Strings.NoControllerConnected}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="10,4,10,8" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Border x:Name="ControllerCardBorder" Grid.Row="1" Style="{StaticResource CardBorder}" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="AccentBar" Grid.Column="0" CornerRadius="2" Background="{DynamicResource DimBrush}" Margin="0,4,0,4"/>

                <Border Grid.Column="1" Width="150" Height="120" CornerRadius="24" Background="{DynamicResource SurfaceBrush}" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="ControllerPhotoImage" Stretch="Uniform" Margin="10" Visibility="Collapsed"/>
                        <Viewbox x:Name="ControllerPhotoFallback" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M11,13H8v3H6v-3H3v-2h3V8h2v3h3V13z M15.5,15c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S16.33,15,15.5,15z M19.5,12c-0.83,0-1.5-0.67-1.5-1.5S18.67,9,19.5,9s1.5,0.67,1.5,1.5S20.33,12,19.5,12z"/>
                        </Viewbox>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Margin="22,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ControllerNameText" Text="{x:Static local:Strings.NoControllerSelected}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConnectionStatusText" Text="{x:Static local:Strings.NotConnected}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ConnectionTypeText" Text="{x:Static local:Strings.BluetoothOrUsb}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    <TextBlock x:Name="ControllerIdText" Text="{x:Static local:Strings.IdPlaceholder}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Grid Width="58" Height="26" VerticalAlignment="Center">
                            <Border Width="52" Height="26" CornerRadius="5" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="2" HorizontalAlignment="Left"/>
                            <Border Width="4" Height="10" CornerRadius="1.5" Background="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,0">
                                <Border x:Name="BatteryBar1" Width="12" Height="18" Margin="0,0,2,0" CornerRadius="1.5" Background="{DynamicResource DimBrush}"/>
                                <Border x:Name="BatteryBar2" Width="12" Height="18" Margin="0,0,2,0" CornerRadius="1.5" Background="{DynamicResource DimBrush}"/>
                                <Border x:Name="BatteryBar3" Width="12" Height="18" CornerRadius="1.5" Background="{DynamicResource DimBrush}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="BatteryText" Text="--" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="BatteryLabelText" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="InfoIconText" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#84A7FF"/>
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock x:Name="InfoTitleText" Text="{x:Static local:Strings.SelectControllerTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="InfoSubtitleText" Text="{x:Static local:Strings.UseButtonSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static local:Strings.BatteryHistoryLabel}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="HistoryRangeText" Grid.Column="1" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="HistoryStatsText" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>

                <Grid Height="130" Margin="0,14,0,0">
                    <TextBlock x:Name="HistoryEmptyText" Text="{x:Static local:Strings.SelectToViewHistory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                    <Canvas x:Name="HistoryChartCanvas" Visibility="Collapsed" SizeChanged="HistoryChartCanvas_SizeChanged"
                            MouseMove="HistoryChartCanvas_MouseMove" MouseLeave="HistoryChartCanvas_MouseLeave" Background="Transparent">
                        <Canvas x:Name="HistoryGridCanvas"/>
                        <Polygon x:Name="HistoryFillPolygon" Fill="#3B82F6" Opacity="0.18"/>
                        <Polyline x:Name="HistoryPolyline" Stroke="#3B82F6" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line x:Name="HistoryHoverLine" Stroke="#3B6BFF" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.6" Visibility="Collapsed"/>
                        <Ellipse x:Name="HistoryHoverDot" Width="8" Height="8" Fill="#3B82F6" Visibility="Collapsed"/>
                        <Border x:Name="HistoryHoverTooltip" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="7,4" Visibility="Collapsed">
                            <TextBlock x:Name="HistoryHoverTooltipText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Canvas>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{x:Static local:Strings.EstimatedTimeRemaining}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="TimeRemainingText" Text="--" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Static local:Strings.AverageUsage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="AverageUsageText" Text="--" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static local:Strings.Tips}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static local:Strings.TipControllerOn}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{x:Static local:Strings.TipBluetoothProximity}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{x:Static local:Strings.TipBluetoothMayNotReport}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{x:Static local:Strings.TipHistoryUpdates}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource DarkCheckBox}" Content="{x:Static local:Strings.StartWithWindows}" Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed"/>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardBorder}">
            <StackPanel>
                <CheckBox x:Name="PhoneControlCheckBox" Style="{StaticResource DarkCheckBox}" Content="{x:Static local:Strings.AllowPhoneControl}" Checked="PhoneControlCheckBox_Changed" Unchecked="PhoneControlCheckBox_Changed"/>
                <TextBlock x:Name="PhoneControlStatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="28,8,0,0" Visibility="Collapsed"/>
                <Border x:Name="PhoneControlQrBorder" Background="White" CornerRadius="8" Padding="8" Margin="28,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                    <Image x:Name="PhoneControlQrImage" Width="140" Height="140" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
