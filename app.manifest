<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity version="1.0.0.0" name="Padlume.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          Necessário para dois recursos opcionais: criar a Tarefa Agendada de "iniciar com o Windows"
          com privilégio máximo (ver Services/StartupManager.cs — colocar um app elevado na chave de
          registro Run clássica não funciona, o Windows nunca eleva itens de inicialização sozinho) e
          gerenciar a regra de firewall do controle pelo celular (ver Services/RemoteControlServer.cs).
        -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 e 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
    </application>
  </compatibility>
  <!--
    Sem isso o Windows não sabe que o app lida com DPI sozinho e escala a janela inteira via bitmap
    em telas com fator de escala != 100% — o que borra/desalinha detalhes finos (ex.: ícones) mesmo
    com o XAML correto. Ter um app.manifest próprio (necessário acima, pro requireAdministrator)
    substitui a detecção automática de DPI que o .NET faria sozinho sem manifest, então precisa ser
    declarado explicitamente aqui.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
    </windowsSettings>
  </application>
</assembly>
