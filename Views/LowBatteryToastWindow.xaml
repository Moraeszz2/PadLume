<Window x:Class="Padlume.LowBatteryToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Padlume"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI">
    <Border x:Name="RootBorder" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="24" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="-30"/>
        </Border.RenderTransform>
        <Grid Margin="4,10,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="2" Background="#EF4444" Margin="0,2,0,2"/>

            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Margin="12,0,14,0" VerticalAlignment="Center">
                <Viewbox Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M11,13H8v3H6v-3H3v-2h3V8h2v3h3V13z M15.5,15c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S16.33,15,15.5,15z M19.5,12c-0.83,0-1.5-0.67-1.5-1.5S18.67,9,19.5,9s1.5,0.67,1.5,1.5S20.33,12,19.5,12z"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Strings.LowBatteryToastTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Grid Width="26" Height="14" VerticalAlignment="Center">
                        <Border Width="23" Height="14" CornerRadius="3" BorderBrush="#EF4444" BorderThickness="1.5" HorizontalAlignment="Left"/>
                        <Border Width="2.5" Height="5" CornerRadius="1" Background="#EF4444" HorizontalAlignment="Right"/>
                        <Border Width="6" Height="8" CornerRadius="1" Background="#EF4444" HorizontalAlignment="Left" Margin="2.5,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="ToastText" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="7,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
