<Window x:Class="Padlume.CompactWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Padlume"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" Padding="12" Width="230">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="2" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="PhotoImage" Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                    <Viewbox x:Name="PhotoFallback" Width="22" Height="22" Stretch="Uniform">
                        <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z M11,13H8v3H6v-3H3v-2h3V8h2v3h3V13z M15.5,15c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S16.33,15,15.5,15z M19.5,12c-0.83,0-1.5-0.67-1.5-1.5S18.67,9,19.5,9s1.5,0.67,1.5,1.5S20.33,12,19.5,12z"/>
                    </Viewbox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" Text="{x:Static local:Strings.NoControllerSelected}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Grid Width="22" Height="11" VerticalAlignment="Center">
                        <Border x:Name="BatteryOutline" Width="19" Height="11" CornerRadius="2" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2" HorizontalAlignment="Left"/>
                        <Border x:Name="BatteryNub" Width="2" Height="4" CornerRadius="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <Border x:Name="BatteryFill" Width="15" Height="7" CornerRadius="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="PercentText" Text="--" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Click="RestoreButton_Click" ToolTip="{x:Static local:Strings.BackToNormalWindow}"
                    Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" VerticalAlignment="Center">
                <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="180"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Button>
        </Grid>
    </Border>
</Window>
